    "start": "bunx --bun vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "@sveltejs/vite-plugin-svelte": "latest",
    "svelte": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@tsconfig/svelte": "latest",
    "svelte-check": "latest",
    "typescript": "5.9.3"
  }
}
